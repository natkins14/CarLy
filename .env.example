# Copy this file to .env and fill in your values.
# Never commit .env to version control.

APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=DEBUG

CARQUERY_API_URL=https://www.carqueryapi.com/api/0.3/
CARQUERY_TIMEOUT_SECONDS=3
CACHE_DIR=.cache/carquery

JWT_SECRET=replace-me
JWT_EXPIRATION_SECONDS=1800
SESSION_COOKIE_NAME=carly_session

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_MAX_TOKENS=400
